# URL pública del sitio (metadata, Open Graph, sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Muestra la página interna /sistema en un build de producción (por defecto solo en desarrollo).
# SHOW_DESIGN_SYSTEM=true

# Número de WhatsApp de contacto, con código de país (ej. 56912345678).
# Solo en el servidor; si falta, el sitio no ofrece continuar por WhatsApp.
# WHATSAPP_NUMBER=
