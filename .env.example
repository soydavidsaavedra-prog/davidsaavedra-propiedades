# URL pública del sitio (metadata, Open Graph, sitemap). Obligatoria en producción.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Muestra la página interna /sistema en un build de producción (por defecto solo en desarrollo).
# SHOW_DESIGN_SYSTEM=true

# Número de WhatsApp de contacto, con código de país (ej. 56912345678).
# Solo en el servidor; si falta, el sitio no ofrece continuar por WhatsApp.
# WHATSAPP_NUMBER=

# Supabase (Project Settings → API). La clave publishable es pública: el acceso
# a datos lo controla RLS. Sin estas variables, en desarrollo se usan datos de
# ejemplo; en producción (Vercel) son obligatorias: sin ellas el build falla.
# NEXT_PUBLIC_SUPABASE_URL=https://<proyecto>.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
